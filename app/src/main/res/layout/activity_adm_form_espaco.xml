<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
        android:layout_marginTop="@dimen/header_top_margin"
        android:background="@drawable/bg_header_navy"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastrar Nova Cápsula"
            style="@style/Text.TitleOnDark" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/etNome"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/bg_input_filled"
                    android:hint="Nome do espaço"
                    android:padding="14dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/etLocal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_filled"
                    android:hint="Localização (Andar/Setor)"
                    android:padding="14dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/etCapacidade"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_filled"
                    android:hint="Capacidade (pessoas)"
                    android:inputType="number"
                    android:padding="14dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="20dp"
                    android:text="@string/salvar_alteracoes"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="@dimen/button_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExcluir"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:text="@string/excluir_capsula"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorDanger"
                    app:cornerRadius="@dimen/button_radius" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav_admin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
